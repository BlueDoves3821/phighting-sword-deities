type: ItemTurret
requirements: [
swordium/250
]
name: "Swordium Laser Turret"
description: '''
Utilitizes the swords as ammo, hit-scanning.
[#ff5959]Swordium: the usual ammo for the turret.
[#70AC30]Darkheartium: applies darkheart's curse, which makes enemies affected by it more vunerable.
[#861C00]Firebrandium: applies the melting status to units.
[#C2C2C2]Ghostwalkerium: deals alot of damage to shield projectors.
[#97CCE1]Icedaggerium: applies the freezing status to units.
[#E2BAF5]Illumiaium: Higher damage, but uses more ammo per shot.
[#A4C360]Venomshankium: applies the corroded status to units.
[#929EAE]Windforceium: pushes units away whilst applying the unmoving status for a short time.
'''
hasShadow: false
health: 1500
maxAmmo: 50
category: turret
range: 750
shootEffect: shootSmokeDisperse
smokeEffect: shootSmokeSquareBig
shootSound: shootLancer
chargeSound: chargeLancer
shootY: 17
reload: 10
moveWhileCharging: false
shoot: {
  firstShotDelay: 32
}
recoil: 2
shake: 2
size: 4
drawer: {
type: DrawTurret
parts: [
{
suffix: "-barrel"
progress: recoil
under: true
moveY: -3
}
]
}
