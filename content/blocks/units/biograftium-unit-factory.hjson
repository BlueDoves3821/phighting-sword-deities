Name: "[#FF6A00]Biograftium []Unit Factory"
description: '''
Can only build [#ff6a00]biograftium []units, sandbox only.
[grey]note: due to the inability for the factory to be turned off because the unit's hidden, please remove [#ff5959]swordium [grey]from the factory to stop producing units.
'''
type: UnitFactory
size: 3
consumesPower: false
plans: [
  {
    unit: biograftium-unit
    time: 30
    requirements: [
swordium/5
]
}
]
buildVisibility: sandboxOnly
hideDatabase: true
alwaysUnlocked: true
category: units
