name: "[#C2C2C2]Ghostwalkerium[] Mender Disabler"
    type: PowerTurret
    description: "Disables all enemy menders/regen projectors in the entire sector, cannot be auto-targeted, requires manual control."
    hideDetails: false
    category: effect
    size: 5
    health: 1750
    armor: 40
    baseExplosiveness: 0
    range: 8000
    rotateSpeed: 0
    reload: 600
    shake: 5
    recoil: 0
    consumesPower: false
    targetable: false
    priority: -2
    shootSound: none
    chargeSound: illuminaium-railgun-charge
    shootY: 0
    shootCone: 360
    soundPitchMin: 0.5
    soundPitchMax: 0.5
    rotate: false
    rotateDraw: false
    rotateDrawEditor: false
    targetGround: false
    targetAir: false
    shoot: {
    firstShotDelay: 180
  }
// the charge region was supposed to glow when the disabler is charging, not glowing idlely, but i kinda liked the way it looked, so it glows idlely.
    drawer: {
    type: DrawTurret
    parts: [
    {
    suffix: "-cooldown"
    progress: reload
    color: FFFFFFFF
    colorTo: FFFFFF00
    top: false
    outline: false
    y: 0
    }
{
suffix: "-charging"
progress: charge
color: FFFFFF
colorTo: C2C2C200
outline: false
}
    ]
    }
    shootType: {
    killShooter: false
    damage: 0
       type: BombBulletType
       shootSound: illuminaium-railgun-shoot
       splashDamageRadius: 8000
       splashDamage: 0
       suppressionRange: 8000
       suppressionDuration: 60000
       suppressionEffectChance: 50
       suppressColor: C8C8C8C2
       instantDisappear: true 
       absorbable: false
       hittable: false 
       collidesAir: true 
       status: slow
       statusDuration: 6000

